import "../constants/fold_chess_bot.ep"
define main:
    set state to starting_state()
    set moves to ordered_moves(state)
    set count to length_list(moves)
    set values to create_list()
    set deepest to create_list()
    set i to 0
    repeat while i < count * 64:
        set ok to append_list(values and 0)
        set i to i + 1
    set i to 0
    repeat while i < count:
        set ok to append_list(deepest and 0)
        set i to i + 1
    set chan to create_channel()
    set i to 0
    repeat while i < count:
        set hand to make_move(state and get_list(moves and i))
        spawn root_worker(hand and 4 and i and chan)
        set i to i + 1
    set done to 0
    repeat while done < count:
        set msg to receive from chan
        set idx to msg / 1099511627776
        set rest to msg - idx * 1099511627776
        set d to rest / 4294967296
        set packed to rest - d * 4294967296
        if d == 255:
            set done to done + 1
        else:
            set ok to set_list(values and idx * 64 + d and packed)
            if d > get_list(deepest and idx):
                set ok to set_list(deepest and idx and d)
    display "C: FLAT matrix + collection ok"
    return 0
