    set ok to set_list(promo_pos and 69 and 64)
    set sig_pr to state_signature(promo_pos)
    set ok to expect_count("APPLY/UNDO perft: four-promotion d3 = 9483" and perft_fast(promo_pos and 3 and calc) and 9483)
    set sig_prnow to state_signature(promo_pos)
    if sig_prnow equals sig_pr:
        display "  ok    promotion position EXACTLY restored"
    else:
        display "  FAIL  promotion position corrupted"
    display "=== apply/undo certified against the census ==="
    return 0
