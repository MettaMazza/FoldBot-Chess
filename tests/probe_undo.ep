    set sig_kiwi to state_signature(kiwi)
    set ok to expect_count("APPLY/UNDO perft: Kiwipete d1 = 48" and perft_fast(kiwi and 1 and calc) and 48)
    set ok to expect_count("APPLY/UNDO perft: Kiwipete d2 = 2039" and perft_fast(kiwi and 2 and calc) and 2039)
    set ok to expect_count("APPLY/UNDO perft: Kiwipete d3 = 97862" and perft_fast(kiwi and 3 and calc) and 97862)
    set sig_know to state_signature(kiwi)
    if sig_know equals sig_kiwi:
        display "  ok    Kiwipete EXACTLY restored (castling paths crossed)"
    else:
        display "  FAIL  Kiwipete corrupted"
    set endgame to empty_state()
    set ok to set_list(endgame and 12 and 1)
    set ok to set_list(endgame and 14 and 1)
    set ok to set_list(endgame and 25 and 4)
