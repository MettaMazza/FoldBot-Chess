    set ok to set_list(endgame and 68 and 0)
    set ok to set_list(endgame and 69 and 64)
    set sig_eg to state_signature(endgame)
    set ok to expect_count("APPLY/UNDO perft: en-passant-pin d4 = 43238" and perft_fast(endgame and 4 and calc) and 43238)
    set sig_egnow to state_signature(endgame)
    if sig_egnow equals sig_eg:
        display "  ok    en-passant endgame EXACTLY restored"
    else:
        display "  FAIL  en-passant endgame corrupted"
    set promo_pos to empty_state()
    set ok to set_list(promo_pos and 5 and 2)
