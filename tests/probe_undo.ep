    set ok to set_list(promo_pos and 56 and 8)
    set ok to set_list(promo_pos and 58 and 8)
    set ok to set_list(promo_pos and 64 and 1)
    set ok to set_list(promo_pos and 65 and 0)
    set ok to set_list(promo_pos and 66 and 0)
