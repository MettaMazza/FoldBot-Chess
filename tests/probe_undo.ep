import "../constants/fold_chess_bot.ep"
define perft_fast with state and depth as Int and calc returning Int:
    if depth == 0:
        return 1
    set side to get_list(state and 64)
    set king_from to king_square(state and side)
    set pseudo to pseudo_moves(state)
    set count to length_list(pseudo)
    set total to 0
    set i to 0
    repeat while i < count:
        set move to get_list(pseudo and i)
        set rest to move - (move / 4096) * 4096
        set from_sq to rest / 64
        set to_sq to rest - from_sq * 64
        set ok to apply_move(state and move and calc)
        set king_now to king_from
        if from_sq == king_from:
            set king_now to to_sq
        set exposed to square_attacked(state and king_now and 1 - side)
        if exposed:
            set ok to undo_move(state and move and calc)
        else:
            set total to total + perft_fast(state and depth - 1 and calc)
            set ok to undo_move(state and move and calc)
        set i to i + 1
    return total
define expect_count with label as Str and got as Int and want as Int:
    if got == want:
        display concat("  ok    " and label)
    else:
        display concat("  FAIL  " and concat(label and concat(" got " and int_to_string(got))))
    return 0
define main:
    set calc to calc_create()
    set state to starting_state()
    set sig_before to state_signature(state)
    set ok to expect_count("APPLY/UNDO perft: start d1 = 20" and perft_fast(state and 1 and calc) and 20)
    set ok to expect_count("APPLY/UNDO perft: start d2 = 400" and perft_fast(state and 2 and calc) and 400)
    set ok to expect_count("APPLY/UNDO perft: start d3 = 8902" and perft_fast(state and 3 and calc) and 8902)
    set sig_now to state_signature(state)
    if sig_now equals sig_before:
        display "  ok    state EXACTLY restored after 9302 apply/undo walks"
    else:
